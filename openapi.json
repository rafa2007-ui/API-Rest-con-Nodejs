{
  "openapi": "3.0.0",
  "info": {
    "title": "API Tienda JWT",
    "description": "API REST de tienda con autenticación JWT. Para probar endpoints protegidos: ejecuta POST /api/login, copia el token y pulsa Authorize. Introduce el token sin escribir 'Bearer ' si Swagger lo añade automáticamente.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Autenticación"
    },
    {
      "name": "tienda",
      "description": "Operaciones de la tienda"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "example": "Jose"
          },
          "password": {
            "type": "string",
            "example": "jose"
          }
        },
        "required": [
          "nombre",
          "password"
        ]
      },
      "LoginResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT válido durante 5 minutos"
          }
        },
        "required": [
          "token"
        ]
      },
      "TiendaInput": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string",
            "example": "Webcam"
          },
          "precio": {
            "type": "number",
            "example": 45
          }
        },
        "required": [
          "nombre",
          "precio"
        ]
      },
      "MongoInsertResponse": {
        "type": "object",
        "properties": {
          "acknowledged": {
            "type": "boolean",
            "example": true
          },
          "insertedId": {
            "type": "string",
            "example": "671a2b3c4d5e6f708192a3b4"
          }
        }
      },
      "MongoUpdateResponse": {
        "type": "object",
        "properties": {
          "acknowledged": {
            "type": "boolean",
            "example": true
          },
          "matchedCount": {
            "type": "integer",
            "example": 1
          },
          "modifiedCount": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "MongoDeleteResponse": {
        "type": "object",
        "properties": {
          "acknowledged": {
            "type": "boolean",
            "example": true
          },
          "deletedCount": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "TiendaItem": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "example": "671a2b3c4d5e6f708192a3b4"
          },
          "nombre": {
            "type": "string",
            "example": "Teclado"
          },
          "precio": {
            "type": "number",
            "example": 100
          }
        },
        "required": [
          "nombre",
          "precio"
        ]
      },
      "MessageResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ]
      }
    }
  },
  "paths": {
    "/api/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Iniciar sesión y obtener token JWT",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inicio de sesión correcto",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponse"
                },
                "example": {
                  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                }
              }
            }
          },
          "400": {
            "description": "Faltan nombre o contraseña"
          },
          "401": {
            "description": "Credenciales incorrectas"
          },
          "500": {
            "description": "Error interno del servidor"
          }
        }
      }
    },
    "/api/tienda": {
      "get": {
        "tags": [
          "tienda"
        ],
        "summary": "Obtener todos los elementos de la tienda",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de elementos de la tienda",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TiendaItem"
                  }
                },
                "example": [
                  {
                    "_id": "671a2b3c4d5e6f708192a3b4",
                    "nombre": "Teclado",
                    "precio": 100
                  }
                ]
              }
            }
          },
          "403": {
            "description": "Token requerido o inválido"
          }
        }
      },
      "post": {
        "tags": [
          "tienda"
        ],
        "summary": "Añadir un elemento a la tienda",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TiendaInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado de la inserción en MongoDB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MongoInsertResponse"
                }
              }
            }
          },
          "403": {
            "description": "Token requerido o inválido"
          }
        }
      }
    },
    "/api/tienda/{id}": {
      "put": {
        "tags": [
          "tienda"
        ],
        "summary": "Actualizar un elemento de la tienda por ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ObjectId de MongoDB",
            "schema": {
              "type": "string"
            },
            "example": "671a2b3c4d5e6f708192a3b4"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TiendaInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Resultado de la actualización en MongoDB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MongoUpdateResponse"
                }
              }
            }
          },
          "403": {
            "description": "Token requerido o inválido"
          }
        }
      },
      "delete": {
        "tags": [
          "tienda"
        ],
        "summary": "Eliminar un elemento de la tienda por ID",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ObjectId de MongoDB",
            "schema": {
              "type": "string"
            },
            "example": "671a2b3c4d5e6f708192a3b4"
          }
        ],
        "responses": {
          "200": {
            "description": "Resultado de la eliminación en MongoDB",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MongoDeleteResponse"
                }
              }
            }
          },
          "403": {
            "description": "Token requerido o inválido"
          }
        }
      }
    }
  }
}